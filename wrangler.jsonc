// Cloudflare Workers configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sb-discord-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db1",
      "database_id": "aed61f03-0275-407a-9529-37f9f55836b0",
      "migrations_dir": "migrations"
    }
  ],

  // The Gateway Durable Object holds the one connection that receives messages, for inline verses
  // (src/gateway/). "migrations" here are Durable Object class changes, not D1 migrations.
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "Gateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gateway"] }],

  // Every minute: posts reading sessions' reminders and start messages, and every 5 minutes wakes
  // the Gateway object in case its own alarm stopped (scheduled() in src/worker.ts).
  "triggers": { "crons": ["* * * * *"] },

  // Logs (console.log/warn/error) appear in the dashboard and in `wrangler tail`.
  "observability": { "enabled": true }
}
