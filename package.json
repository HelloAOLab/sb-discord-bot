{
  "name": "sb-discord-app",
  "version": "1.0.0",
  "description": "TypeScript Discord bot with an Express server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx src/scripts/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "discord-api-types": "^0.38.56",
    "discord-interactions": "^4.4.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "free-use-bible-api": "^0.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
