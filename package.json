{
  "name": "sb-discord-app",
  "version": "1.0.0",
  "description": "Discord app for seedbible.org, running on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy-worker": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx src/scripts/deploy-commands.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "bible-passage-reference-parser": "^4.0.0",
    "discord-api-types": "^0.38.56",
    "discord-interactions": "^4.4.0",
    "free-use-bible-api": "^0.4.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
