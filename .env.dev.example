# The dev bot's settings, for `pnpm dev:bot`. Copy to .env.dev and fill in. Never commit .env.dev.
#
# The dev bot is a separate Discord application from the real one (create it at
# https://discord.com/developers/applications), invited only to your dev server. The names are the
# same as in .env; `pnpm dev:bot` reads only this file, and so does the local Worker it starts.

# Bot → Token
DISCORD_TOKEN=your-dev-bot-token
# General Information → Application ID
DISCORD_CLIENT_ID=your-dev-application-id
# General Information → Public Key
DISCORD_PUBLIC_KEY=your-dev-public-key
# Optional: your dev server's ID (turn on Developer Mode in Discord, then right-click the server →
# Copy Server ID). Commands are registered there and appear at once; without it they're global
# and can take up to an hour.
DISCORD_DEV_GUILD_ID=your-dev-server-id
